# Optional local configuration. Copy to .env only if you load it in your environment.
# SQLite database path. For persistent hosting, point this at a mounted persistent disk.
DATABASE_PATH=app/campus.db

# Local demo users are seeded by default. Disable on public deployments.
SEED_DEMO_USERS=true

# Change these before any public deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Campus Administrator
